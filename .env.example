GROQ_API_KEY=your_groq_api_key_here
# Optional overrides (defaults shown):
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
KAGGLE_TOKEN=your_kaggle_bearer_token_here

# Port the backend listens on. The frontend never needs this — app/index.html
# calls the API via window.location.origin (same-origin), so it always finds
# the backend regardless of which port it's actually running on. This value
# only matters if you start the server with `python app/main.py` instead of
# an explicit `uvicorn --port` flag.
PORT=8000
